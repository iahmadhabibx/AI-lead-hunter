# Application
NODE_ENV=development
APP_NAME=ai-job-hunter
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000

# Session / auth
SESSION_COOKIE_NAME=aijh_session
SESSION_SECRET=replace-with-32-plus-char-random-string-for-local-dev
SESSION_TTL_SECONDS=604800

# PostgreSQL — runtime app role
# Runtime app role (subject to RLS). Do not use the migration owner for the API.
DATABASE_URL=postgres://aijh_app:aijh_app_dev_password@localhost:5433/aijh

# PostgreSQL — migrations / bootstrap (local only)
DB_ADMIN_URL=postgres://aijh:aijh_dev_password@localhost:5433/aijh

# Redis
REDIS_URL=redis://localhost:6379

# File storage (local disk for development)
STORAGE_ROOT=./uploads
MAX_UPLOAD_BYTES=10485760

# AI (optional in Phase 0; required for Phase 1 inference)
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Logging
LOG_LEVEL=info
