# Application
NODE_ENV=development
APP_NAME=ai-job-hunter
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000

# Session / auth
SESSION_COOKIE_NAME=aijh_session
SESSION_SECRET=replace-with-32-plus-char-random-string-for-local-dev
SESSION_TTL_SECONDS=604800

# PostgreSQL — runtime app role
# Runtime app role (subject to RLS). Do not use the migration owner for the API.
DATABASE_URL=postgres://aijh_app:aijh_app_dev_password@localhost:5433/aijh

# PostgreSQL — migrations / bootstrap (local only)
DB_ADMIN_URL=postgres://aijh:aijh_dev_password@localhost:5433/aijh

# Redis
REDIS_URL=redis://localhost:6379

# File storage (local disk for development)
# Relative paths resolve from the monorepo root so API + worker share one directory.
STORAGE_ROOT=.local/uploads
MAX_UPLOAD_BYTES=10485760

# AI (optional in Phase 0; required for Phase 1 inference)
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Logging
LOG_LEVEL=info

# Job sources — JSON array of *configured employer boards* (NOT global search).
# Example Lever: {"type":"lever","key":"acme-lever","site":"acme","eu":false,"enabled":true}
# Local demo uses public Greenhouse boards (Stripe + GitLab). Replace with your boards in production.
# Live discovery never invents listings.
JOB_SOURCES_JSON='[{"type":"greenhouse","key":"stripe-gh","boardToken":"stripe","enabled":true,"displayName":"Stripe"},{"type":"greenhouse","key":"gitlab-gh","boardToken":"gitlab","enabled":true,"displayName":"GitLab"}]'
JOB_STALE_AFTER_HOURS=72
JOB_INGEST_CONCURRENCY=2

# Auth rate limits (in-process; use Redis limiter for multi-instance production)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
