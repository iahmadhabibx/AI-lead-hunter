    "@aijh/feedback": "workspace:*",
    "@aijh/job-connectors": "workspace:*",
    "@aijh/observability": "workspace:*",
    "@aijh/security": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/testing": "^10.4.15",
    "bullmq": "^5.34.5",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
